<%- include('../layouts/header') %>

<div style="max-width: 680px; margin: 1.5rem auto;">
  <div style="margin-bottom: 1.25rem;">
    <a href="/books" class="btn btn-secondary btn-sm">&larr; Back to Catalogue</a>
  </div>

  <div class="table-card" style="padding: 2rem;">
    <h2 class="section-title" style="font-size: 1.5rem; margin-bottom: 0.35rem;">
      <%= isEdit ? 'Edit Book Details' : 'Add New Book to Collection' %>
    </h2>
    <p class="section-subtitle" style="margin-bottom: 1.5rem;">
      <%= isEdit ? 'Update metadata and adjust total available copies' : 'Register a new title into the library catalogue' %>
    </p>

    <form action="<%= isEdit ? '/books/' + book._id : '/books' %>" method="POST" class="form-grid">
      <div class="form-group full-width">
        <label for="title">Book Title <span class="required">*</span></label>
        <input type="text" id="title" name="title" class="styled-input" required value="<%= book.title || '' %>" placeholder="e.g., Structure and Interpretation of Computer Programs">
      </div>

      <div class="form-group half-width">
        <label for="author">Author(s) <span class="required">*</span></label>
        <input type="text" id="author" name="author" class="styled-input" required value="<%= book.author || '' %>" placeholder="e.g., Harold Abelson, Gerald Jay Sussman">
      </div>

      <div class="form-group half-width">
        <label for="isbn">ISBN <span class="required">*</span></label>
        <input type="text" id="isbn" name="isbn" class="styled-input" required value="<%= book.isbn || '' %>" placeholder="e.g., 978-0262510875">
      </div>

      <div class="form-group half-width">
        <label for="category">Discipline / Category <span class="required">*</span></label>
        <select id="category" name="category" class="styled-select" required>
          <option value="">Select Category</option>
          <% const categories = ['Computer Science', 'Literature', 'Science & Nature', 'History & Philosophy', 'Arts & Architecture', 'Economics & Society']; %>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= book.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group half-width">
        <label for="year">Publication Year</label>
        <input type="number" id="year" name="year" class="styled-input" value="<%= book.year || '' %>" placeholder="e.g., 1996">
      </div>

      <div class="form-group half-width">
        <label for="totalCopies">Total Copies <span class="required">*</span></label>
        <input type="number" id="totalCopies" name="totalCopies" class="styled-input" min="1" max="100" required value="<%= book.totalCopies || 3 %>">
        <% if (isEdit) { %>
          <span class="field-hint">Current available: <%= book.availableCopies %> (<%= book.totalCopies - book.availableCopies %> on loan)</span>
        <% } %>
      </div>

      <div class="form-group half-width">
        <label for="shelfLocation">Shelf Location / Call Number</label>
        <input type="text" id="shelfLocation" name="shelfLocation" class="styled-input" value="<%= book.shelfLocation || '' %>" placeholder="e.g., QA76.6 .A25">
      </div>

      <div class="form-group half-width">
        <label for="coverStyle">Cover Style Theme</label>
        <select id="coverStyle" name="coverStyle" class="styled-select">
          <option value="tech-deep" <%= book.coverStyle === 'tech-deep' ? 'selected' : '' %>>Cyberpunk Tech Indigo</option>
          <option value="literature-classic" <%= book.coverStyle === 'literature-classic' ? 'selected' : '' %>>Literary Emerald & Gold</option>
          <option value="science-cosmic" <%= book.coverStyle === 'science-cosmic' ? 'selected' : '' %>>Cosmic Violet Gradient</option>
          <option value="history-amber" <%= book.coverStyle === 'history-amber' ? 'selected' : '' %>>Historical Parchment Amber</option>
          <option value="minimal-dark" <%= book.coverStyle === 'minimal-dark' ? 'selected' : '' %>>Minimal Dark Slate</option>
        </select>
      </div>

      <div class="form-group half-width">
        <label for="coverUrl">Custom Cover Image URL (Optional)</label>
        <input type="url" id="coverUrl" name="coverUrl" class="styled-input" value="<%= book.coverUrl || '' %>" placeholder="https://images.unsplash.com/...">
      </div>

      <div class="form-group full-width">
        <label for="description">Book Synopsis</label>
        <textarea id="description" name="description" class="styled-textarea" rows="4" placeholder="Brief summary of the book..."><%= book.description || '' %></textarea>
      </div>

      <div class="form-group full-width" style="margin-top: 1rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
        <a href="/books" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Create Book' %></button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
