<%- include('../layouts/header') %>

<!-- Catalogue Toolbar -->
<form action="/books" method="GET" class="catalogue-toolbar" id="catalogueFilterForm">
  <div class="search-box-wrap">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" name="q" value="<%= searchQuery %>" class="search-input" placeholder="Search by title, author, ISBN..." aria-label="Search books catalogue">
    <% if (searchQuery) { %>
      <a href="/books" class="clear-search-btn" title="Clear search">✕</a>
    <% } %>
  </div>

  <div class="toolbar-controls">
    <!-- Availability Filter -->
    <div class="filter-select-wrap">
      <select name="availability" class="styled-select" onchange="this.form.submit()">
        <option value="all" <%= selectedAvailability === 'all' ? 'selected' : '' %>>All Availability</option>
        <option value="available" <%= selectedAvailability === 'available' ? 'selected' : '' %>>Available Now (In Stock)</option>
        <option value="low" <%= selectedAvailability === 'low' ? 'selected' : '' %>>Low Stock (1 left)</option>
        <option value="unavailable" <%= selectedAvailability === 'unavailable' ? 'selected' : '' %>>Checked Out (0 left)</option>
      </select>
    </div>

    <!-- Sort Selector -->
    <div class="filter-select-wrap">
      <select name="sort" class="styled-select" onchange="this.form.submit()">
        <option value="popularity" <%= selectedSort === 'popularity' ? 'selected' : '' %>>Sort: Most Popular</option>
        <option value="title-asc" <%= selectedSort === 'title-asc' ? 'selected' : '' %>>Sort: Title (A-Z)</option>
        <option value="title-desc" <%= selectedSort === 'title-desc' ? 'selected' : '' %>>Sort: Title (Z-A)</option>
        <option value="author" <%= selectedSort === 'author' ? 'selected' : '' %>>Sort: Author</option>
        <option value="year-desc" <%= selectedSort === 'year-desc' ? 'selected' : '' %>>Sort: Publication (Newest)</option>
        <option value="available" <%= selectedSort === 'available' ? 'selected' : '' %>>Sort: Copies Available</option>
      </select>
    </div>

    <% if (locals.currentUser && currentUser.role === 'librarian') { %>
      <a href="/books/new" class="btn btn-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Add Book</span>
      </a>
    <% } %>
  </div>
</form>

<!-- Category Filter Pills -->
<div class="category-pills-bar">
  <a href="/books?category=all<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %><%= selectedAvailability !== 'all' ? '&availability=' + selectedAvailability : '' %>" 
     class="category-pill <%= selectedCategory === 'all' ? 'active' : '' %>">All Disciplines</a>
  
  <% const categories = ['Computer Science', 'Literature', 'Science & Nature', 'History & Philosophy', 'Arts & Architecture', 'Economics & Society']; %>
  <% categories.forEach(cat => { %>
    <a href="/books?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %><%= selectedAvailability !== 'all' ? '&availability=' + selectedAvailability : '' %>" 
       class="category-pill <%= selectedCategory === cat ? 'active' : '' %>"><%= cat %></a>
  <% }); %>
</div>

<!-- Results Metadata -->
<div class="results-metadata-bar">
  <div class="results-count-text">
    Showing <strong><%= books.length %></strong> of <strong><%= totalCount %></strong> titles in collection
    <% if (selectedCategory !== 'all') { %> &bull; Discipline: <em><%= selectedCategory %></em><% } %>
    <% if (selectedAvailability !== 'all') { %> &bull; Status: <em><%= selectedAvailability %></em><% } %>
  </div>
  <% if (searchQuery || selectedCategory !== 'all' || selectedAvailability !== 'all') { %>
    <a href="/books" class="btn btn-secondary btn-sm">Reset All Filters</a>
  <% } %>
</div>

<!-- Book Cards Grid -->
<% if (books.length === 0) { %>
  <div class="empty-state-card">
    <div class="empty-icon">📚</div>
    <h3>No matching books found</h3>
    <p>Try adjusting your search keywords, resetting discipline filters, or check back later.</p>
    <a href="/books" class="btn btn-secondary btn-sm">Reset Filters</a>
  </div>
<% } else { %>
  <div class="books-grid">
    <% 
      const COVER_GRADIENTS = {
        'tech-deep': 'linear-gradient(135deg, #1e1b4b 0%, #312e81 45%, #4338ca 100%)',
        'literature-classic': 'linear-gradient(135deg, #064e3b 0%, #047857 50%, #059669 100%)',
        'science-cosmic': 'linear-gradient(135deg, #3b0764 0%, #6b21a8 50%, #9333ea 100%)',
        'history-amber': 'linear-gradient(135deg, #78350f 0%, #b45309 50%, #d97706 100%)',
        'minimal-dark': 'linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%)'
      };

      books.forEach(book => {
        const bgStyle = book.coverUrl 
          ? `background-image: url('${book.coverUrl}'); background-size: cover;`
          : `background: ${COVER_GRADIENTS[book.coverStyle] || COVER_GRADIENTS['tech-deep']};`;

        const availClass = book.availableCopies === 0 ? 'out-of-stock' : book.availableCopies === 1 ? 'low-stock' : 'in-stock';
        const availLabel = book.availableCopies === 0 ? 'Checked Out (0 left)' : `${book.availableCopies} of ${book.totalCopies} Available`;
        const canBorrow = book.availableCopies > 0;
        const isAlreadyBorrowed = userBorrowedBookIds.includes(book._id.toString());
    %>
      <div class="book-card">
        <div class="book-card-cover-wrap" style="<%= bgStyle %>">
          <div class="book-cover-gradient" style="background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);">
            <div class="book-cover-spine"></div>
            <div class="book-badge-category"><%= book.category %></div>
            <div>
              <div class="book-cover-title-badge"><%= book.title %></div>
              <div class="book-cover-author-badge"><%= book.author %></div>
            </div>
          </div>
        </div>

        <div class="book-card-body">
          <a href="/books/<%= book._id %>" class="book-title" style="text-decoration: none;"><%= book.title %></a>
          <div class="book-author">by <%= book.author %></div>
          <p class="book-description-snippet"><%= book.description || 'No description available.' %></p>

          <div class="book-meta-pills">
            <span class="meta-pill" title="Shelf Location"><%= book.shelfLocation %></span>
            <span class="meta-pill" title="Year"><%= book.year || 'N/A' %></span>
            <span class="meta-pill" title="Circulation">★ <%= book.borrowCount || 0 %> borrowed</span>
          </div>

          <div style="margin-bottom: 0.75rem;">
            <span class="availability-pill <%= availClass %>">
              <span class="availability-indicator-dot"></span>
              <%= availLabel %>
            </span>
          </div>

          <div class="book-card-footer">
            <a href="/books/<%= book._id %>" class="btn btn-secondary btn-sm">Details</a>

            <% if (locals.currentUser && currentUser.role === 'librarian') { %>
              <div class="librarian-btn-group">
                <a href="/books/<%= book._id %>/edit" class="icon-btn" title="Edit Book">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </a>
                <form action="/books/<%= book._id %>/delete" method="POST" onsubmit="return confirm('Delete this book from the catalogue?');" style="display: inline;">
                  <button type="submit" class="icon-btn btn-delete" title="Delete Book">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            <% } else { %>
              <% if (isAlreadyBorrowed) { %>
                <button type="button" class="btn btn-secondary btn-sm" disabled style="opacity: 0.8; color: var(--accent-gold);">
                  ✓ On Loan to You
                </button>
              <% } else if (canBorrow) { %>
                <form action="/circulation/borrow/<%= book._id %>" method="POST" style="display: inline;">
                  <button type="submit" class="btn btn-primary btn-sm">Borrow</button>
                </form>
              <% } else { %>
                <button type="button" class="btn btn-primary btn-sm" disabled>Out of Stock</button>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('../layouts/footer') %>
