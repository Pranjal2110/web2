<%- include('layouts/header') %>

<div style="max-width: 580px; margin: 3rem auto; text-align: center;">
  <div class="table-card" style="padding: 3rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h2 class="section-title" style="margin-bottom: 0.5rem;">An Error Occurred</h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem;">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request.' %>
    </p>
    <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
  </div>
</div>

<%- include('layouts/footer') %>
