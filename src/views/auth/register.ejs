<%- include('../layouts/header') %>

<div style="max-width: 520px; margin: 2rem auto;">
  <div class="table-card" style="padding: 2rem;">
    <h2 class="section-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Register New Account</h2>
    <p class="section-subtitle" style="margin-bottom: 1.5rem;">Create a patron or staff library profile</p>

    <form action="/register" method="POST" class="form-grid">
      <div class="form-group full-width">
        <label for="name">Full Name <span class="required">*</span></label>
        <input type="text" id="name" name="name" class="styled-input" required placeholder="e.g., Jonathan Sterling">
      </div>

      <div class="form-group full-width">
        <label for="email">Email Address <span class="required">*</span></label>
        <input type="email" id="email" name="email" class="styled-input" required placeholder="patron@athenaeum.edu">
      </div>

      <div class="form-group full-width">
        <label for="password">Password <span class="required">*</span></label>
        <input type="password" id="password" name="password" class="styled-input" required minlength="6" placeholder="At least 6 characters">
      </div>

      <div class="form-group half-width">
        <label for="role">Account Role <span class="required">*</span></label>
        <select id="role" name="role" class="styled-select" required>
          <option value="member">Library Patron (Member)</option>
          <option value="librarian">Staff Administrator (Librarian)</option>
        </select>
      </div>

      <div class="form-group half-width">
        <label for="borrowLimit">Borrowing Quota (Books)</label>
        <input type="number" id="borrowLimit" name="borrowLimit" class="styled-input" value="3" min="1" max="10">
      </div>

      <div class="form-group full-width" style="margin-top: 0.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%;">Create Account</button>
      </div>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.84rem; color: var(--text-muted);">
      Already have an account? <a href="/login" style="color: var(--primary); font-weight: 600;">Sign in here</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
